diff --git a/apps/data-pipeline/dining-scraper/src/menu-entries.ts b/apps/data-pipeline/dining-scraper/src/menu-entries.ts
new file mode 100644
--- /dev/null
+++ b/apps/data-pipeline/dining-scraper/src/menu-entries.ts
@@ -0,0 +1,15 @@
+type StationSkus = { simple: string[]; configurable?: { sku: string; variants: string[] }[] };
+
+/** Configurable parents have no unambiguous serving. Keep their own attributes,
+ * and scope new identities by station because diningDish owns stationId. */
+export function menuEntries(stationId: number, skus: StationSkus) {
+  return [
+    ...new Set(skus.simple),
+    ...new Set((skus.configurable ?? [])
+      .filter((parent) => !parent.variants.some((sku) => skus.simple.includes(sku)))
+      .map((parent) => parent.sku)),
+  ].map((sku) => ({
+    sku,
+    id: skus.simple.includes(sku) ? sku : `${sku}:station:${stationId}`,
+  }));
+}
diff --git a/apps/data-pipeline/dining-scraper/src/menu-entries.test.mjs b/apps/data-pipeline/dining-scraper/src/menu-entries.test.mjs
