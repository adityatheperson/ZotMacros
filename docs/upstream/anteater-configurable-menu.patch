--- /dev/null
+++ b/apps/data-pipeline/dining-scraper/src/menu-entries.test.mjs
@@ -0,0 +1,11 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { menuEntries } from './menu-entries.ts';
+test('preserves simple identities and configurable parents once per station', () => {
+ const skus={simple:['known','known'],configurable:[{sku:'chicken',variants:['large','small']},{sku:'chicken',variants:[]}]};
+ assert.deepEqual(menuEntries(1926,skus),[{sku:'known',id:'known'},{sku:'chicken',id:'chicken:station:1926'}]);
+ assert.notEqual(menuEntries(1932,skus)[1].id,menuEntries(1926,skus)[1].id);
+});
+test('does not duplicate a simple variant as its configurable parent',()=>{
+ assert.deepEqual(menuEntries(1926,{simple:['small'],configurable:[{sku:'chicken',variants:['small','large']}]}),[{sku:'small',id:'small'}]);
+});
